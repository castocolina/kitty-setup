# Auto-detect text and normalize to LF on commit; keep CRLF only where required.
* text=auto eol=lf

# Explicit text formats
*.md       text eol=lf
*.py       text eol=lf diff=python
*.toml     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.conf     text eol=lf
*.sh       text eol=lf
*.bash     text eol=lf
*.zsh      text eol=lf
*.fish     text eol=lf
*.ini      text eol=lf
Makefile   text eol=lf
LICENSE    text eol=lf

# Binary types — never diff or normalize
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.gz       binary
*.zip      binary
*.tar      binary
*.woff     binary
*.woff2    binary

# Linguist hints (GitHub language stats)
docs/**          linguist-documentation
specs/**         linguist-documentation
.specify/**      linguist-documentation
*.md             linguist-detectable=true

# Exclude housekeeping from sdist / GitHub release tarballs
.gitattributes   export-ignore
.gitignore       export-ignore
.github/         export-ignore
.specify/        export-ignore
.claude/         export-ignore
.vscode/         export-ignore
docs/            export-ignore
tests/           export-ignore
