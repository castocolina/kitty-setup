# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/
env/
.python-version

# Test & coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Tool caches
.ruff_cache/
.mypy_cache/
.pyright/
.cache/

# Editors / OS
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# VS Code — keep shared settings, ignore user-local state
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/launch.json

# Local overrides
.env
.env.*
!.env.example

# Spec Kit local-only state
.specify/init-options.json

# Secrets / SSH (never)
*.pem
*.key
id_rsa*

# Hypothesis scratch (never committed; promoted by manual rewrite)
tmp/

# Backups created by config_updater
*.bak.*

# Harness session scratch (in case it ever lands outside tmp/)
.kitty-setup-test/

# Local tooling caches (CodeGraph index, agent-toolkit skill registry)
.codegraph/
.atl/

# Harness-created agent worktrees (live inside the repo, never committed)
.claude/worktrees/

# Project-local GSD install (open-gsd/gsd-core) — reinstallable, never committed
.claude/gsd-core/
.claude/gsd-file-manifest.json
.claude/gsd-install-state.json
.claude/.gsd-profile
.claude/.gsd-staging/
.claude/agents/gsd-*
.claude/commands/gsd-*
.claude/skills/gsd-*
.claude/hooks/gsd-*
.claude/hooks/lib/
.claude/hooks/managed-hooks-registry.cjs
.claude/hooks/package.json
.claude/scripts/
